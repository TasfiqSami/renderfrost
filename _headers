# RenderFrost SMP — recommended security headers
#
# Deploy-time configuration. These are NOT applied by the static files alone:
# a host must send them. This file is read automatically by Netlify.
# For other hosts, copy the same values into their header configuration.
#
# The CSP below is tested against this site's actual resource usage:
#   - styles: same-origin only (no inline styles anywhere in the markup)
#   - scripts: same-origin only (no inline scripts, no event handler attributes)
#   - fonts:   same-origin, self-hosted
#   - images:  same-origin + data: URIs
#   - media:   same-origin (the soundtrack)
#   - connect: 'self' (a HEAD request checks the audio file exists)
# No external origins are contacted by any page.

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=(), usb=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'none'; script-src 'self'; style-src 'self'; img-src 'self' data: https://cdn.discordapp.com https://media.discordapp.net; font-src 'self'; media-src 'self'; connect-src 'self'; upgrade-insecure-requests

# Cache assets briefly until filenames are content-fingerprinted.
/assets/fonts/*
  Cache-Control: public, max-age=604800

/assets/img/*
  Cache-Control: public, max-age=604800

/assets/css/*
  Cache-Control: public, max-age=0, must-revalidate

/assets/js/*
  Cache-Control: public, max-age=0, must-revalidate

# Audio is large, but its filename is not content-fingerprinted.
/assets/audio/*
  Cache-Control: public, max-age=604800
